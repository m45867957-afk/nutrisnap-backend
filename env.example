# این کلیدها را از داشبورد Stripe (dashboard.stripe.com) بگیر
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxx
STRIPE_PRICE_ID_MONTHLY=price_xxxxxxxxxxxxxxxxxxxx
STRIPE_PRICE_ID_YEARLY=price_xxxxxxxxxxxxxxxxxxxx

# این کلید را از console.anthropic.com بگیر (برای تحلیل عکس خوراکی‌ها)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxx

# این کلید رایگان را از fdc.nal.usda.gov/api-key-signup.html بگیر
# (برای گرفتن مقادیر تغذیه‌ای واقعی از دیتابیس رسمی، نه فقط حدس هوش مصنوعی)
USDA_API_KEY=xxxxxxxxxxxxxxxxxxxx

# یه رمز دلخواه خودت بساز (هر متن تصادفی، مثلاً یه رشته‌ی طولانی و پیچیده) —
# این برای فعال‌کردن دستی Premium روی حساب خودت جهت تست استفاده می‌شود. جایی منتشرش نکن.
ADMIN_SECRET=یک-رمز-دلخواه-و-پیچیده-بساز

# این کلید را از resend.com بگیر (برای ارسال ایمیل کد تأیید هنگام ورود کاربر).
# اگر تنظیم نشود، کد تأیید فقط در لاگ سرور چاپ می‌شود (فقط برای تست محلی مناسب است، نه تولید واقعی).
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
# آدرس فرستنده‌ی ایمیل؛ تا دامنه‌ی خودت را در Resend تأیید نکنی، از onboarding@resend.dev استفاده کن.
RESEND_FROM_EMAIL=NutriSnap <onboarding@resend.dev>

# آدرس دقیق فرانت‌اند خودت (برای محدود کردن CORS فقط به همین دامنه).
FRONTEND_URL=https://cactus-4e3aa9.netlify.app

PORT=3001
